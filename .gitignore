node_modules/
dist/
*.log
.DS_Store

# Local save fixtures & device state (never commit game saves)
decoded/*.db
data/backup_*/
*.hcsbak
cycle-state.json
hs_repo.zip

# Local PyInstaller output (the shippable zip lives in client/dist)
client/build/

# Local license store (used only when DATABASE_URL is unset)
data/.hs-licenses.json

client/__pycache__/
__pycache__/
*.pyc

# Agent/skill installs live in the working tree only — local tooling, not product
.agents/
.claude/
agent/
data/skills/
skills-lock.json

# A stale repo-level `cache=` in .npmrc used to make npm create a directory named
# `G:\hs_build\npm-cache` inside the working tree. Keep that out of git forever.
G:*npm-cache/

# Android platform-tools are downloaded by CI, never committed
client/adb/
