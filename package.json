{
  "name": "homescapes-save-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Professional Homescapes save editor: server-side save algorithms plus a Windows client that drives ADB.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node --experimental-strip-types src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/engine/*.test.ts",
    "season-ticket": "node --experimental-strip-types tools/edit_season_ticket.ts",
    "preview": "vite preview",
    "start": "node --experimental-strip-types src/server/main.ts",
    "test:ui": "node tools/ui_smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run test:ui && npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  }
}
