# Keep npm quiet and offline-friendly. Do NOT set `cache` here: a repo-level
# cache path is machine specific (this file used to pin it to G:\hs_build,
# which made `npm ci` create a literal "G:\hs_build\npm-cache" folder inside the
# working tree on every non-Windows machine and in CI). Set it per machine:
#   npm config set cache <your path>
audit=false
fund=false
